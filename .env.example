# Copie para .env.local e preencha no ambiente local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Segredo privado do servidor: nunca use prefixo NEXT_PUBLIC_ e nunca versione o valor.
# Necessário apenas para operações server-side de upload e tarefas privilegiadas.
SUPABASE_SECRET_KEY=

# Keep uploads disabled until a trusted antimalware scanner is integrated.
JURISAI_ENABLE_UPLOADS=false
